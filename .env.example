HERMES_INSTANCE=hermes-lincoln
HERMES_PUBLIC_URL=https://hermes.exemplo.com
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=

# Caddy instalado no host. Use uma porta livre por instância.
HERMES_HOST_PORT=19119

# Caddy em Docker. Use o nome real da rede Docker compartilhada com o Caddy.
CADDY_NETWORK=caddy
